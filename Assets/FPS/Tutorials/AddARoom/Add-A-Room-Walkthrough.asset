  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'You can use the <b>Move Tool</b> to move any selected GameObject in the Scene view.


      When you select it, you''ll see the <b>Move Gizmo</b>: three arrows that you can select to move the GameObject on a single plane.


      <b>Tip:</b> If you select the cube at the intersection of the arrows, you can freely move the GameObject on multiple planes at once.'
